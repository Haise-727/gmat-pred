# Git ignore file for NASA GMAT Early Exit project

# Generated data (Parquet files, 60+ MB)
data/
!data/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Virtual environments
.venv/
env/
venv/

# Jupyter
.ipynb_checkpoints/

# GMAT output
gmat_scripts/output/
*.report
*.data

# Logs
*.log

# Tool caches written into the repo root at runtime
.matplotlib/

# OS
.DS_Store
Thumbs.db

# Node / frontend generated files
node_modules/
frontend/node_modules/
frontend/dist/
.vite/
frontend/.vite/
package-lock.json

# AI tool directories
.agents/
.kiro/
.trae/
.cursor/
.windsurf/
.copilot/
.claude/

# AI tool lock files
skills-lock.json

# Generated output files
trajectory.txt

# Model checkpoints and scalers (large binary files)
models/**/*.pt
models/**/*.pkl

# Ablation scratch runs. These train throwaway models purely to produce a
# reports/ artifact; the checkpoints and their meta/history are not serving
# state and must not be mistaken for the per-planet production models.
models/_norm_ablation/
models/_rare_mode_sweep/

# Generated reports.
#
# The heavy artifacts (figures, checkpoints) stay out, but the RESULT files do
# not: every number in docs/ and in the paper comes from one of these JSON/TeX
# tables, and until now they were untracked, so the claims had nothing committed
# backing them and could not be diffed when a pipeline re-run changed them.
# They total well under a megabyte.
reports/**
!reports/**/
!reports/**/*.json
!reports/**/*.md
!reports/**/*.tex

# One binary exception. prediction_traces.npz is the raw held-out P(fail) behind
# Figure 2 of the paper — 64 KB, and the only artifact in the repository that
# lets someone redraw that figure without first re-training the ablation, whose
# checkpoints are (correctly) ignored above.
!reports/prediction_traces.npz

# Parquet split temps
data/_*_split.parquet

# Detached pipeline logs
.runlogs/

# LaTeX build intermediates. The .tex is generated from docs/paper/content.py
# and the .pdf is committed as the paper deliverable, but everything the engine
# writes on the way there is noise in a diff.
docs/paper/*.aux
docs/paper/*.bbl
docs/paper/*.blg
docs/paper/*.out
docs/paper/*.toc
docs/paper/*.synctex.gz
docs/paper/*.fls
docs/paper/*.fdb_latexmk
